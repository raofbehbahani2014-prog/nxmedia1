<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= site.siteName %> | تولید محتوا و آموزش اینستاگرام - تولید ریلز، پست، استوری، مدیریت پیج و مشاوره اینستاگرام">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container nav-wrap">
      <a href="/" class="logo"><%= site.logoText1 %><span><%= site.logoText2 %></span></a>

      <button class="mobile-toggle" aria-label="منو">☰</button>

      <nav class="main-nav">
        <ul>
          <li><a href="/"><%= site.navLabels.home %></a></li>
          <li><a href="/services"><%= site.navLabels.services %></a></li>
          <li><a href="/portfolio"><%= site.navLabels.portfolio %></a></li>
          <li><a href="/education"><%= site.navLabels.education %></a></li>
          <li><a href="/courses"><%= site.navLabels.courses %></a></li>
          <li><a href="/about"><%= site.navLabels.about %></a></li>
          <li><a href="/blog"><%= site.navLabels.blog %></a></li>
          <li><a href="/contact"><%= site.navLabels.contact %></a></li>
        </ul>
      </nav>

      <div class="header-actions">
        <a href="/consultation" class="btn btn-ghost"><%= site.buttons.consultation %></a>
        <a href="/request-project" class="btn btn-primary"><%= site.buttons.requestProject %></a>
        <% if (currentUser) { %>
          <a href="/client/dashboard" class="btn btn-outline"><%= site.buttons.clientPanel %></a>
        <% } else { %>
          <a href="/client/login" class="btn btn-outline"><%= site.buttons.clientLogin %></a>
        <% } %>
      </div>
    </div>
  </header>
