<%- include('../../partials/header') %>

<section class="hero" style="padding:80px 0;">
  <div class="container">
    <h1>ورود به <span class="highlight">پنل مشتری</span></h1>
    <p>برای مشاهده وضعیت پروژه، تقویم محتوایی و فاکتورها وارد شوید.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="form-box">
      <% if (error) { %>
        <p style="color:#DC2626; background:#FEE2E2; padding:10px 14px; border-radius:10px; font-size:14px;"><%= error %></p>
      <% } %>
      <form action="/client/login" method="POST">
        <div class="form-group">
          <label>ایمیل</label>
          <input type="email" name="email" required>
        </div>
        <div class="form-group">
          <label>رمز عبور</label>
          <input type="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">ورود</button>
      </form>
      <p style="font-size:12px; color:var(--gray); text-align:center; margin-top:14px;">
        نسخه نمایشی: این فرم اسکلت اولیه ورود کاربر است و به دیتابیس واقعی متصل نیست.
      </p>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
